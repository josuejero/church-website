---
import adventurerConfig from "../../data/adventurer";
import Button from "../ui/Button.astro";

const props = Astro.props as {
  showMemoCard?: boolean;
  showCalendarCard?: boolean;
};
const showMemoCard = props.showMemoCard !== false;
const showCalendarCard = props.showCalendarCard !== false;
const { registration, memo, calendar, guideText } = adventurerConfig;
const registrationIsPlaceholder = new URL(registration.url).hostname === "example.com";
---

<section class="grid--cards adventurer-cta" aria-label="Adventurer action cards">
  <p class="muted small adventurer-cta__guide" aria-hidden="true">{guideText}</p>

  <article class="card card--link adventurer-cta__card">
    <div class="card__body stack--tight">
      <div>
        <h3>Springfield Junior Pioneers Adventurer Club registration</h3>
        {registrationIsPlaceholder ? (
          <p>The registration form is not currently available from this site. Check the campus calendar or contact the church for current registration information.</p>
        ) : (
          <p>The secure external form gathers the information noted above so we can confirm enrollment, share updates, and coordinate volunteers.</p>
        )}
      </div>
      <div class="adventurer-cta__action">
        {registrationIsPlaceholder ? (
          <div class="cluster">
            <Button variant="secondary" href={calendar.ctaHref}>View campus calendar</Button>
            <Button variant="ghost" href="/connect/contact">Contact the church</Button>
          </div>
        ) : (
          <>
            <Button variant="primary" href={registration.url} external aria-describedby="adventurer-register-note">
              {registration.ctaLabel}
            </Button>
            <p class="muted small adventurer-cta__note" id="adventurer-register-note">{registration.note}</p>
          </>
        )}
      </div>
    </div>
  </article>

  {showMemoCard ? (
    <article class="card card--link adventurer-cta__card">
      <div class="card__body stack--tight">
        <div>
          <h3>Adventurer Memo</h3>
          <p>Read the latest memo for reminders, badge focuses, and volunteer needs so you can support the next Adventurer gathering.</p>
        </div>
        <div class="adventurer-cta__action">
          <Button variant="secondary" href={memo.path} aria-describedby="adventurer-memo-note">
            {memo.ctaLabel}
          </Button>
          <p class="muted small adventurer-cta__note" id="adventurer-memo-note">{memo.note}</p>
        </div>
      </div>
    </article>
  ) : null}

  {showCalendarCard ? (
    <article class="card card--link adventurer-cta__card">
      <div class="card__body stack--tight">
        <div>
          <h3>Campus calendar</h3>
          <p>Check the live church calendar for Adventurer gatherings, Pathfinder dates, and shared ministry events.</p>
        </div>
        <div class="adventurer-cta__action">
          <Button variant="ghost" href={calendar.ctaHref} aria-describedby="adventurer-calendar-note">
            {calendar.ctaLabel}
          </Button>
          <p class="muted small adventurer-cta__note" id="adventurer-calendar-note">{calendar.note}</p>
        </div>
      </div>
    </article>
  ) : null}
</section>
