---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Button from "../../../components/ui/Button.astro";

const connectFormUrl = "https://docs.google.com/forms/d/e/1FAIpQLSe8tLdlnVMI7tGSlVptPOlY4oE6nqm0ihw71NVCwIfZFaE0ag/viewform?usp=header";
---

<BaseLayout
  title="Connect Card"
  description="Open the First Springfield SDA Connect Card in Google Forms."
>
  <section class="stack connect-card-bridge" aria-labelledby="connect-card-title">
    <div class="connect-card-bridge__intro stack--tight">
      <p class="muted small">Google Forms</p>
      <h1 id="connect-card-title">Connect Card</h1>
      <p class="muted">
        The Connect Card is hosted in Google Forms. Use it to share your visit plans,
        prayer needs, ministry interests, or the best way for the church team to follow up.
      </p>
    </div>

    <article class="card stack--tight">
      <h2>Open the Connect form</h2>
      <p class="muted">
        The form opens in a new tab on Google Forms. Please avoid sending urgent or sensitive
        information through this form.
      </p>
      <div class="cluster">
        <Button href={connectFormUrl} external>
          Open Connect form
        </Button>
        <Button href="/connect/contact" variant="secondary">
          Contact us instead
        </Button>
      </div>
    </article>

    <p class="muted small">
      If the Google Form does not load, use the contact page and someone from the church team will help.
    </p>
  </section>
</BaseLayout>

<style>
  .connect-card-bridge {
    max-width: 52rem;
  }

  .connect-card-bridge__intro {
    margin-bottom: var(--space-4);
  }
</style>
